# =====================================================
# Environment Variables for Stripe + Supabase Integration
# =====================================================
# Copy this file to .env.local for local development
# Add these same variables to Vercel Dashboard > Settings > Environment Variables
# =====================================================

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Stripe Price IDs
# Create these in Stripe Dashboard > Products > Add Product
# Monthly: Recurring, ₪49/month
# Yearly: Recurring, ₪490/year  
# Lifetime: One-time, ₪499
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_YEARLY=price_your_yearly_price_id
STRIPE_PRICE_LIFETIME=price_your_lifetime_price_id

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Site URL (your Vercel deployment URL)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# =====================================================
# Setup Instructions:
# =====================================================
#
# 1. STRIPE SETUP:
#    a. Go to https://dashboard.stripe.com/products
#    b. Create 3 products:
#       - "מנוי חודשי" (Monthly) - ₪49/month recurring
#       - "מנוי שנתי" (Yearly) - ₪490/year recurring
#       - "לכל החיים" (Lifetime) - ₪499 one-time
#    c. Copy each Price ID (starts with price_)
#
# 2. WEBHOOK SETUP:
#    a. Go to https://dashboard.stripe.com/webhooks
#    b. Add endpoint: https://your-app.vercel.app/api/stripe-webhook
#    c. Select events:
#       - checkout.session.completed
#       - customer.subscription.created
#       - customer.subscription.updated
#       - customer.subscription.deleted
#       - invoice.payment_succeeded
#       - invoice.payment_failed
#    d. Copy the Signing Secret (starts with whsec_)
#
# 3. SUPABASE SETUP:
#    a. Run the SQL migration in supabase-stripe-migration.sql
#    b. Get your Service Role Key from Project Settings > API
#       (This is the secret key, NOT the anon key!)
#
# 4. VERCEL SETUP:
#    a. Go to your Vercel project > Settings > Environment Variables
#    b. Add all variables above
#    c. Redeploy your project
#
# =====================================================
